{
  "manifest_version": 3,
  "name": "YubiKey Fill",
  "version": "0.7.4",
  "description": "Fill an approved site's one-time code from your YubiKey.",
  "minimum_chrome_version": "106",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; connect-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["field.js", "prompt.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "icons": { "16": "icons/key-16.png", "32": "icons/key-32.png", "48": "icons/key-48.png", "128": "icons/key-128.png" },
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_title": "Fill YubiKey code",
    "default_popup": "panel.html",
    "default_icon": { "16": "icons/key-16.png", "32": "icons/key-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "incognito": "split",
  "commands": {
    "fill-code": {
      "description": "Fill the one-time code on the approved site",
      "suggested_key": { "default": "Alt+Shift+Y" }
    }
  }
}
